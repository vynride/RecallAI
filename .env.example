# RecallAI environment. Copy to `.env` and fill in. `.env` is gitignored.
# Host-published ports: frontend 127.0.0.1:3005 (nginx proxies to it),
# backend 127.0.0.1:8005 (dev only). Postgres/Redis are internal, not published.

# ─── Auth (Auth.js / NextAuth v5) ───────────────────────────────────────────
# Secret used to sign JWTs — generate with: openssl rand -base64 32
# AUTH_SECRET is read by the Next.js client; NEXTAUTH_SECRET is the SAME value,
# read by the FastAPI backend to verify the same JWTs. Set both identical.
AUTH_SECRET=
NEXTAUTH_SECRET=

# Public URL where the app is reached (Auth.js uses it to build callback URLs).
#   Local dev:  http://localhost:3005
#   Production: https://recall-ai.vynride.dev
AUTH_URL=http://localhost:3005

# Google OAuth — https://console.cloud.google.com/ → APIs & Services → Credentials
# Redirect URI: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers → OAuth Apps
# Callback URL: <AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Backend ─────────────────────────────────────────────────────────────────
# 32-byte secret used to encrypt per-user stored Gemini API keys (BYOK).
# Generate with: openssl rand -base64 32
GEMINI_KEY_PEPPER=

# Comma-separated CORS origins the FastAPI backend accepts (mostly matters for dev).
ALLOWED_ORIGINS=http://localhost:3005

# ─── Database — your existing/hosted Postgres (production) ───────────────────
# This stack does NOT run Postgres in production. Provide the connection string
# to your existing instance. In prod the app joins your external `backend` Docker
# network and reaches Postgres by its container name on that network (replace the
# host below). The async driver (postgresql+asyncpg://) is required.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@postgres:5432/recallai

# ─── Redis (runs in Docker — Celery broker + result backend) ─────────────────
# Compose builds REDIS_URL / CELERY_* from this. Generate: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# ─── Local dev Postgres (docker-compose.override.yml only) ───────────────────
# The dev override runs a throwaway Postgres container from these. Ignored in
# production (DATABASE_URL above is used instead).
POSTGRES_USER=recallai
POSTGRES_PASSWORD=recallai
POSTGRES_DB=recallai

# ─── Storage ──────────────────────────────────────────────────────────────────
# Absolute host path for Docker bind-mount volumes (Postgres/Redis data +
# uploaded PDFs + rendered results). Use a Linux-native FS (ext4/btrfs/xfs).
RECALLAI_DATA_DIR=/home/user/recallai-data

# ─── Celery (optional) ────────────────────────────────────────────────────────
# Number of concurrent worker processes (default: 4).
# CELERY_CONCURRENCY=4

# ─── SEO ──────────────────────────────────────────────────────────────────────
# Canonical base URL for OG tags, sitemap, robots.txt (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://recall-ai.vynride.dev

# ─── Analytics — Umami (host-managed / external, optional) ───────────────────
# Umami is not run in Docker. Point the client at your host/managed instance.
# Leave blank to disable tracking.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
